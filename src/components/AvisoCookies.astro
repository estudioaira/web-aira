---
import sitio from "../datos/sitio.json";
import { ruta } from "../lib/ruta.js";
const c = sitio.cookies;
---
<aside class="cookies" id="avisoCookies" aria-label={c.etiquetaAria} hidden>
  <p>{c.texto} <a href={ruta("/politica-cookies")}>{c.enlace}</a>.</p>
  <button type="button" data-entendido>{c.boton}</button>
</aside>

<style>
  .cookies { position: fixed; z-index: 35; left: max(16px, env(safe-area-inset-left)); bottom: max(16px, env(safe-area-inset-bottom)); width: min(440px, calc(100vw - 112px)); display: grid; gap: 0.75rem; padding: 1rem 1.25rem; background: var(--marfil); color: var(--espresso); border: 1px solid var(--espresso); font-size: 0.9rem; line-height: 1.45; }
  .cookies[hidden] { display: none; }
  .cookies p { margin: 0; }
  .cookies a { text-decoration: underline; text-underline-offset: 4px; }
  .cookies button { justify-self: start; min-height: 44px; padding: 0.5rem 1.25rem; font: inherit; cursor: pointer; background: var(--espresso); color: var(--marfil); border: 1px solid var(--espresso); }
  .cookies button:hover { background: transparent; color: var(--espresso); }
  @media (max-width: 480px) { .cookies { width: calc(100vw - 96px); font-size: 0.85rem; } }
</style>

<script>
  const CLAVE = "aira-cookies-visto";
  const aviso = document.getElementById("avisoCookies");
  if (aviso) {
    let visto = false;
    try { visto = localStorage.getItem(CLAVE) === "1"; } catch {}
    if (!visto) aviso.hidden = false;
    aviso.querySelector("[data-entendido]")?.addEventListener("click", () => {
      try { localStorage.setItem(CLAVE, "1"); } catch {}
      aviso.hidden = true;
    });
  }
</script>
